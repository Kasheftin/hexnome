{
  "name": "@hexnome/rules",
  "version": "0.0.0",
  "private": true,
  "//": "Built to CJS for Node consumers. The frontend bypasses this entirely via a Vite alias to src/, so editing a rule still hot-reloads with no build; the backend requires real JavaScript, so dist/ exists for it.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
