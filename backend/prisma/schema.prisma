// The game as the server keeps it: what it is, and everything that has happened to it.
//
// There are only two tables, because there is only one kind of state. A game is its journal — see
// packages/rules/src/gameLog.ts — so the board, the drawer, the source and the score are all derived
// by replaying commands rather than stored anywhere.
//
// ## The log is a chain, and that is load-bearing
//
// Every command names the command it was built on, and `@@unique([gameId, prevSeq])` makes the
// database refuse two children of the same parent. That single constraint is the whole concurrency
// design: there is no sequence to allocate, no row to lock and no transaction, because the insert
// itself adjudicates. The service reads the head to *reason* — whose turn, what the deck owes — and
// that read is allowed to be stale.
//
// An earlier version allocated a dense 1…N per game inside a transaction holding `SELECT … FOR
// UPDATE`. Producing a dense sequence means knowing the current one, which means read-then-write,
// which means holding a lock. Letting the numbers be sparse removes the read, and letting the
// constraint do the checking removes the lock.

// Prisma 7 generates into the project rather than into node_modules, so the client is ordinary
// source the compiler can see.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Stated rather than inferred. Left to itself the generator emits ESM, which compiles to a file
  // holding both `exports.` and `import.meta.url` — and Node, seeing the latter, loads it as ESM and
  // dies on the former. The generated code carries `@ts-nocheck`, so tsc never warns.
  moduleFormat = "cjs"
}

// Prisma 7 keeps the connection out of the schema: the CLI reads it from prisma.config.ts and the
// running server passes a driver adapter. The schema describes shape only.
datasource db {
  provider = "mysql"
}

model Game {
  /// How the game is found. This is the id in /game?id=…
  id        String   @id @db.VarChar(64)

  /// How the game is generated: the deck, the agenda, the reshuffles, the scatter.
  ///
  /// Deliberately *not* the id. Copying a seed into a new game replays the same deal, which is what
  /// makes "beat your score on that board" possible. Two ids may share a seed; the reverse is
  /// meaningless.
  seed      String   @db.VarChar(64)

  /// GameSettings as chosen at setup. Re-validated by parseGameSettings on the way out — a JSON
  /// column is editable in the database, and the client already refuses to trust localStorage for
  /// exactly this reason.
  settings  Json

  /// running | finished. Derived from the log; denormalised so a future lobby can filter without
  /// replaying every game.
  status    String   @default("running") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commands  Command[]

  @@index([status, updatedAt])
}

/// One step of the game loop: a turn a seat committed, and everything that followed from it.
model Command {
  /// Globally unique and ascending. Only the *order* means anything.
  ///
  /// Allocated by the database, which is the point — there is nothing to read first, so nothing to
  /// lock. Numbers are sparse within a game and may jump by any amount; a cursor only ever needs
  /// "bigger than what I have".
  ///
  /// Sparse autoincrement is only safe because the chain is. Left alone it has a nasty failure: A
  /// takes 10 and has not committed, B takes 11 and commits, a poller advances its cursor to 11,
  /// then A commits 10 and `> 11` never returns it. The unique `prevSeq` below is what stops two
  /// writes to one game from ever being in flight together, so that window cannot open.
  seq      Int      @id @default(autoincrement())

  gameId   String   @db.VarChar(64)

  /// The `seq` this command was built on, and the concurrency guard.
  ///
  /// `0` for the genesis command — not NULL, which MySQL permits repeatedly in a unique index and
  /// which would therefore let the chain fork at its root.
  prevSeq  Int

  /// The seat that submitted this, or `server`. Authorization only: it cannot serve as the
  /// concurrency guard, because two commands from the *same* seat both pass it — and a duplicate is
  /// far more often a retry or a double-tap than a second player.
  author   String   @db.VarChar(32)

  /// The seat that may act next; empty once the game is over. Read from the head to gate the next
  /// command without replaying anything.
  awaiting String   @db.VarChar(32)

  /// Client-minted, and the deduplication guard.
  ///
  /// Earns its index on the retry path: the server commits, the response is lost, the client
  /// resends. Without this the resend collides on `prevSeq` and the client cannot tell "refused"
  /// from "already applied". With it, the conflict is recognised and the original row returned.
  cmdId    String   @db.VarChar(64)

  /// `LogEntry[]` from @hexnome/rules: what the author's turn did.
  ///
  /// Verified before it is stored — replayed against the chain through the same rules the client
  /// validated with, and refused whole if any of it was not allowed.
  effects  Json

  /// `LogEntry[]`: what the server added in reply — a restock, a plate turning over.
  ///
  /// Separate from `effects`, and the separation is load-bearing rather than tidy. A client applies
  /// its own turn optimistically, so when the acknowledgement arrives it has *already* got
  /// everything in `effects`; replaying the whole row would apply them twice, and skipping the whole
  /// row would miss the deal. It needs the boundary, so the boundary is a column.
  ///
  /// Both halves live in one row so they are one INSERT, atomic under InnoDB without a transaction.
  /// A client must never be able to observe a move landing without the deal it triggered.
  response Json

  at       DateTime @default(now())

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Two commands cannot share a parent. This is the concurrency design, in one line.
  @@unique([gameId, prevSeq])

  /// A retry is not a second command.
  @@unique([gameId, cmdId])

  /// The cursor, and the head.
  @@index([gameId, seq])
}
