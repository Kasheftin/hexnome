// One table, because there is one kind of state: a bag of tiles and the pile they come back to.
//
// The desk knows nothing about games, turns or players — see packages/rules/src/desk.ts. A game uses
// two rows, one for its tiles and one for its plates, and nothing here can tell them apart.
//
// ## Why the state is a JSON column
//
// The desk is a value: two arrays and a counter, read and written whole on every request. Normalising
// it into a row per tile would buy nothing — there is no query that wants a single tile, and the order
// of the arrays *is* the data. `config` is the shape `DeskState` serialises to.

// Prisma 7 generates into the project rather than into node_modules, so the client is ordinary
// source the compiler can see.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Stated rather than inferred. Left to itself the generator emits ESM, which compiles to a file
  // holding both `exports.` and `import.meta.url` — and Node, seeing the latter, loads it as ESM and
  // dies on the former. The generated code carries `@ts-nocheck`, so tsc never warns.
  moduleFormat = "cjs"
}

// Prisma 7 keeps the connection out of the schema: the CLI reads it from prisma.config.ts and the
// running server passes a driver adapter. The schema describes shape only.
datasource db {
  provider = "mysql"
}

model Desk {
  /// A uuid, minted on creation. This is the only handle a client ever gets.
  id String @id @db.VarChar(36)

  /// What the order was derived from. Kept because a reshuffle needs it, not for lookup.
  ///
  /// Not secret *yet* — the client mints it and sends it, which is why anyone holding it can build a
  /// second desk and read the whole order. Moving the minting to the server is the next step.
  seed String @db.VarChar(200)

  /// Bumped on every write, and checked on the way in.
  ///
  /// Two draws racing on one desk would otherwise both read the same state and both write it back,
  /// and the second would silently undo the first — a tile dealt twice, with nothing to notice it.
  /// The conditional update makes that a 409 instead. Same discipline as a chain, three lines long.
  version Int @default(0)

  /// The whole desk as one value: { seed, copies, exclude, desk, discard, generation }.
  config Json

  createdAt DateTime @default(now())
}

/// A table: what was chosen, who is at it, and how far along it is.
///
/// It shares a database with `Desk` and knows nothing about it — a desk is found by its own id and a
/// game holds no reference to one. What ties them together is the **seed**, below, and the tying is
/// done by the service rather than by a foreign key.
model Game {
  /// How the game is found. This is the id in `/game?id=…`, and the whole of a share link.
  id String @id @db.VarChar(36)

  /// What the game is dealt from — the desks, the agenda, the scatter.
  ///
  /// **Minted here and never sent to a client.** Anyone holding it can build a second desk from the
  /// same order and read the whole deal, which is exactly what the move off the client was for. It is
  /// deliberately not the id: an id is a share link and a seed is a secret, and one value cannot be
  /// both.
  seed String @db.VarChar(64)

  /// `GameSettings` as chosen at setup, re-validated by `parseGameSettings` on the way out.
  ///
  /// A JSON column is editable in the database, so it is read back through the same gate the client
  /// uses on localStorage, for the same reason.
  settings Json

  /// waiting | running | finished.
  ///
  /// Every game begins as `waiting`, singleplayer included: a solo game is one whose only seat is
  /// claimed by its creator, so it starts in the same breath and takes the same path as the rest.
  /// A second code route for solo is a second route to keep in step.
  status String @default("waiting") @db.VarChar(16)

  /// Bumped on every write, and broadcast to whoever is watching.
  ///
  /// The whole of what a watcher is told: a number that says "something moved, go and look". It
  /// carries no game data, so it can be sent to anyone holding the id, and a client that misses one
  /// is only as slow as its polling.
  seq Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * The two desks this game deals from, once it has started.
   *
   * Null while a table is still filling: a desk is built from the settings, and the settings are not
   * final until the last chair is taken. They are the server's handles — a client never sees one, and
   * the deal is the server's to make.
   */
  tileDeskId  String? @db.VarChar(36)
  plateDeskId String? @db.VarChar(36)

  /**
   * The **public seed**: the opening plates, the round targets and the petal stream.
   *
   * Null for a game that is its own, which is nearly all of them — a game's public seed is normally
   * its id, and this column exists only so a *repeat* can inherit another game's. The two were the
   * same value for as long as no game was ever dealt twice, and the primary key cannot be reused.
   *
   * Public, and safely so: it is some game's id, and an id was always the thing both ends derive the
   * opening from. The secret half is `seed` above, which the desks are built from and which never
   * leaves this process. A repeat inherits both, which is what makes it the same game.
   */
  dealKey String? @db.VarChar(36)

  /**
   * Which named game this is, for the high score board — or null for one that is nobody's.
   *
   * **Derived at creation, never sent by a client.** `matchPreset` compares the validated settings
   * against what each preset deals at that seat count, so a client cannot claim a board it did not
   * play. See packages/rules/src/presets.ts.
   *
   * A preset that is retuned must be given a new id rather than edited in place, or every game
   * already recorded under the old one keeps sitting on a board it no longer belongs to.
   */
  presetId String? @db.VarChar(16)

  /**
   * How many seats, duplicated out of `settings` on purpose.
   *
   * A board is a preset *and* a seat count — a score at two players says nothing about a score at
   * four — and `settings` is a JSON column, so the count cannot be indexed where it already lives.
   */
  players Int?

  /**
   * The best score anybody made, written once when the game ends.
   *
   * Null until then, and null forever for a game that was abandoned, which is what keeps unfinished
   * games off the board without a second condition to keep in step.
   */
  score Int?

  /**
   * Who made it. The seat, and the name it was carrying at the time.
   *
   * The seat is stored as well as the name because a player may decline to name themselves — the
   * column allows an empty string — and only the seat number can produce "Player 3" afterwards.
   * Ties go to the lowest seat: the first to sit.
   *
   * Denormalised from `Seat` deliberately. A name is fixed when the chair is claimed and never
   * changes, so there is nothing here that can drift, and a board is a list ordered by a column on
   * this table alone.
   */
  winnerSeat Int?
  winnerName String? @db.VarChar(40)

  seats    Seat[]
  commands Command[]

  @@index([status, updatedAt])

  /**
   * The high score board, in one index: pick a preset and a seat count, then walk the scores
   * downwards. Unfinished games have a null `score` and sort to the far end, so a page never reaches
   * them.
   */
  @@index([presetId, players, score])
}

/// A place at a table, and the secret that proves it is yours.
model Seat {
  gameId String @db.VarChar(36)

  /// **Zero-based, matching the tableau.** The screen says "Player 1"; the row says 0.
  ///
  /// Also the turn order: seats are claimed in order and the game walks them.
  seat Int

  /// What the player called themselves. Null until claimed; empty means they did not say.
  name String? @db.VarChar(40)

  /// The secret that says a request is from this seat.
  ///
  /// Null while the seat is free, which is also the claim: an `UPDATE … WHERE token IS NULL` either
  /// takes the seat or affects no rows, so two people opening one link cannot both get in. The write
  /// adjudicates, not a read — the same discipline as the desk's version check.
  ///
  /// **Leaves the server exactly once**, in the response to the join that mints it. Never in a game
  /// or a seat list.
  token String? @db.VarChar(36)

  joined DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, seat])
  @@unique([gameId, token])
}

/// One committed turn, and the chain that orders them.
///
/// A game's log is these rows; the board, the drawers, the source and the score are all folded from
/// them by `replayGame`. Nothing about a game in progress is stored anywhere else, so there is
/// nothing that can drift from it.
///
/// ## The chain is the whole concurrency design
///
/// Every command names the one it was built on, and `@@unique([gameId, prevSeq])` makes the database
/// refuse two children of one parent. There is no sequence to allocate, no row to lock and no
/// transaction, because the insert itself adjudicates: forty simultaneous turns claiming one parent
/// leave exactly one winner and thirty-nine conflicts.
///
/// The two halves need each other. Sparse autoincrement alone has a nasty window — A takes 10 and has
/// not committed, B takes 11 and commits, a reader advances past 11, then A commits 10 and is never
/// seen again. The chain is what stops two writes to one game being in flight together, so the window
/// cannot open.
model Command {
  /// Globally unique and ascending. Only the **order** means anything.
  ///
  /// Allocated by the database, which is the point: there is nothing to read first, so nothing to
  /// lock. Numbers are sparse within a game and may jump by any amount; a cursor only ever needs
  /// "bigger than what I have".
  seq Int @id @default(autoincrement())

  gameId String @db.VarChar(36)

  /// The `seq` this was built on, and the guard.
  ///
  /// `0` for the first command — not NULL, which MySQL permits repeatedly in a unique index and which
  /// would therefore let the chain fork at its root.
  prevSeq Int

  /// The seat that submitted this, or null for the server's own — a deal.
  ///
  /// Derived from the seat token, never taken from the body: a client that could name its own seat
  /// could take somebody else's turn. Authorization only, and it cannot double as the concurrency
  /// guard, because two commands from one seat both pass it.
  author Int?

  /// Client-minted, and the deduplication guard.
  ///
  /// It earns its index on the retry path: the server commits, the response is lost, the client
  /// resends. Without it the resend collides on `prevSeq` and the client cannot tell "refused" from
  /// "already applied". With it, the conflict is recognised and the original row handed back.
  cmdId String @db.VarChar(36)

  /// The rules' `Command`, verbatim — an **intent**, not its effects.
  ///
  /// That is the whole reason this column is alone where attempt 1 needed two. Its log recorded
  /// mutations, so a client that had applied its own turn optimistically needed the boundary between
  /// what it already held and what the server added. An intent has no such halves: every client folds
  /// the same row through the same `applyCommand` and arrives at the same board.
  command Json

  at DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Two commands cannot share a parent. This is the concurrency design, in one line.
  @@unique([gameId, prevSeq])

  /// A retry is not a second command.
  @@unique([gameId, cmdId])

  /// The cursor, and the head.
  @@index([gameId, seq])
}
