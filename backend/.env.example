# Local development database. Copy to .env and set a real password.
#
#   mysql -u root -p -e "CREATE DATABASE hexnome_desk CHARACTER SET utf8mb4;"
#
# Its own database rather than `hexnome`, which still holds the first backend attempt's tables —
# `prisma db push` reconciles a whole database to the schema, so sharing one would drop them.
#
DATABASE_URL="mysql://root:password@localhost:3306/hexnome_desk"
PORT=3000
