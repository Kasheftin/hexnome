# Copy to .env to change any of these. .env is gitignored; this file is not.
#
# Everything here must start with VITE_ — that is the prefix Vite exposes to client code, and a
# variable named anything else is simply absent from the built bundle.

# Where the API lives: a prefix put on every request and on the head socket.
#
# `/api` in development and in production alike. nginx proxies /api to the backend on the server, and
# the Vite dev server proxies the same path to localhost:3000, so the two behave identically and a
# path bug shows up locally instead of on the box.
#
# An absolute origin works too — VITE_API_BASE=https://hexnome.com/api — for pointing a local
# frontend at a deployed backend. Leaving it unset falls back to /api, so a fresh clone runs with no
# setup at all.
VITE_API_BASE=/api
